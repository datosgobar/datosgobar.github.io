---
import { secciones } from '../data/recursos.json';
const { titulo, descripcion } = Astro.props;
// Mismos accesos que la franja del hub en los sitios de documentación.
const accesos = [
  ...secciones.map((s) => ({ texto: { 'Guías y manuales': 'Guías', 'Documentación de APIs': 'APIs' }[s.titulo] ?? s.titulo, href: `/#${s.id}` })),
  { texto: 'Comunidad', href: '/#comunidad' },
];
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="/estilo.css" />
  </head>
  <body>
    <header class="cabecera">
      <div class="interior">
        <a class="marca" href="/"><img src="/logos/datos-gob-ar-blanco.png" alt="datos.gob.ar" width="823" height="160" /><span>Recursos</span></a>
        <nav aria-label="Secciones">
          {accesos.map((a) => <a href={a.href}>{a.texto}</a>)}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="pie">
      <div class="interior">
        <p>Dirección de Datos Abiertos. El código de cada recurso es abierto y está en <a href="https://github.com/datosgobar">GitHub</a>.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .interior { max-width: var(--ancho); margin: 0 auto; padding-inline: var(--margen); }
  .cabecera { position: sticky; top: 0; z-index: 10; background: var(--navy); }
  .cabecera .interior { display: flex; align-items: center; gap: 2rem; min-height: 5.5rem; }
  .marca { display: inline-flex; align-items: center; gap: .9rem; font-weight: 600; color: #fff; text-decoration: none; white-space: nowrap; }
  .marca img { height: 2.25rem; width: auto; }
  .marca span { padding-left: .9rem; border-left: 1px solid rgba(255,255,255,.35); font-size: 1.05rem; }
  nav { display: flex; gap: 1.5rem; margin-left: auto; overflow-x: auto; }
  nav a { color: #fff; opacity: .85; font-weight: 600; font-size: .925rem; text-decoration: none; white-space: nowrap; padding-block: .5rem; }
  nav a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 3px; }
  .pie { background: var(--gris-fondo); margin-top: 0; padding-block: 2.5rem; font-size: .925rem; color: var(--texto-2); }
  .pie .interior { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
  .pie p { margin: 0; }
  /* En pantallas angostas la navegación pasa a su propia fila y se desliza de costado. */
  @media (max-width: 50rem) {
    .cabecera .interior { flex-wrap: wrap; gap: 0 1rem; padding-block: .5rem; }
    nav { margin-left: 0; width: 100%; gap: 1.25rem; }
  }
</style>
